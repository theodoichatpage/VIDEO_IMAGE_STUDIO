{
  "manifest_version": 3,
  "name": "VIDEO IMAGE STUDIO — ChatGPT Bridge",
  "version": "0.4.27",
  "description": "Kết nối VIDEO IMAGE STUDIO với tab ChatGPT đang mở.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://wtxgjsorpqjanxoevxuw.supabase.co/*",
    "https://video-image-studio.vercel.app/*",
    "https://*.vercel.app/*",
    "https://video-image-studio-web-ma9gms.v2.appdeploy.ai/*",
    "https://*.oaiusercontent.com/*",
    "https://oaidalleapiprodscus.blob.core.windows.net/*",
    "https://*.blob.core.windows.net/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "reply-reader.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://video-image-studio.vercel.app/*",
        "https://*.vercel.app/*",
        "https://video-image-studio-web-ma9gms.v2.appdeploy.ai/*"
      ],
      "js": [
        "web_bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}

